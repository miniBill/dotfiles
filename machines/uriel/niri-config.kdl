output "Unknown Unknown Unknown" {
    // unrecognized primary
    mode "2560x1440"
    position x=0 y=0
}

output "ASUSTek COMPUTER INC ASUS PB278QV 0x0000FA11" {
    // secondary
    mode "1920x1080"
    position x=2560 y=0
}

workspace "secondary" {
    open-on-output "ASUSTek COMPUTER INC ASUS PB278QV 0x0000FA11"
}

workspace "chat" {
    open-on-output "ASUSTek COMPUTER INC ASUS PB278QV 0x0000FA11"
}

spawn-at-startup "discord"
window-rule {
    match app-id="discord"
    open-on-workspace "secondary"
    default-column-width { proportion 0.3; }
}

spawn-at-startup "spotify"
window-rule {
    match app-id="spotify"
    open-on-workspace "secondary"
    default-column-width { proportion 0.3; }
}

spawn-at-startup "super-productivity"
window-rule {
    match app-id="superproductivity"
    open-on-workspace "chat"
    default-column-width { proportion 0.3; }
}

spawn-at-startup "Telegram"
window-rule {
    match app-id="org.telegram.desktop"
    open-on-workspace "chat"
    default-column-width { proportion 0.3; }
}

spawn-at-startup "signal-desktop" "--password-store=kwallet6"
window-rule {
    match app-id="signal"
    open-on-workspace "chat"
    default-column-width { proportion 0.3; }
}
